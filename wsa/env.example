# Ключи. Все необязательны: без них система работает на бесплатных источниках, но медленнее.
# Файл .env в .gitignore — не коммитить.

# Solana: быстрый RPC (бесплатный тариф — 10 запросов/с, пакетная загрузка). https://helius.dev
HELIUS_API_KEY=

# Поиск кандидатов по реализованному PnL за 30/90 дней (бесплатный тариф Standard). https://bds.birdeye.so
BIRDEYE_API_KEY=

# EVM-сети (Ethereum, Base, Arbitrum, Optimism, Polygon): нужен хотя бы один.
# Blockscout PRO — бесплатный ключ proapi_… на https://dev.blockscout.com
BLOCKSCOUT_API_KEY=
# Etherscan V2 — бесплатно только Ethereum, Polygon, Arbitrum. https://etherscan.io/apis
ETHERSCAN_API_KEY=

# CoinGecko Demo — сектора и листинги быстрее (100 запросов/мин вместо ~10)
COINGECKO_API_KEY=

# Биржа — те же имена, что в bbbot. Права ключа: ТОЛЬКО торговля, без вывода средств.
# Для demo/testnet — ключи демо-счёта / тестовой сети соответственно.
BYBIT_API_KEY=
BYBIT_API_SECRET=
# BINANCE_API_KEY= / BINANCE_API_SECRET=
# OKX_API_KEY= / OKX_API_SECRET= / OKX_API_PASSWORD=
